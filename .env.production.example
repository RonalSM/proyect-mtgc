# Entorno de Producción MTGC
NODE_ENV=production
PORT=80
HOST=0.0.0.0

# Base de datos PostgreSQL
POSTGRES_USER=mtgc_user
POSTGRES_PASSWORD=genera_una_contrasena_segura_aqui
POSTGRES_DB=mtgc_db
DATABASE_URL=postgresql://mtgc_user:genera_una_contrasena_segura_aqui@postgres:5432/mtgc_db?schema=public

# Caché y Pub/Sub Redis
REDIS_URL=redis://redis:6379

# Claves criptográficas JWT y Sesión (Mínimo 32 caracteres)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_random
SESSION_SECRET=super_secret_cookie_session_key_32_characters_random

# Dominios y CORS
CORS_ORIGIN=https://mesa.tu-dominio.com

# Scryfall Rate Limit y User-Agent identificado
SCRYFALL_API_URL=https://api.scryfall.com
SCRYFALL_USER_AGENT=MTGCommanderVirtualTable/1.0.0 (admin@tu-dominio.com)
