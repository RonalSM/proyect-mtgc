{
  "name": "mtgc-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Mesa Virtual de Commander (MTG) - Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/server/dist/index.js",
    "prisma:generate": "prisma generate --schema=apps/server/prisma/schema.prisma",
    "build:shared": "npm run --workspace=@mtgc/shared build",
    "build:web": "npm run build:shared && npm run --workspace=@mtgc/web build",
    "postinstall": "npm run prisma:generate && npm run build:shared",
    "build": "npm run prisma:generate && npm run --workspaces --if-present build",
    "dev": "concurrently -k -n \"shared,server,web\" -c \"cyan,green,magenta\" \"npm run --workspace=@mtgc/shared dev\" \"npm run --workspace=@mtgc/server dev\" \"npm run --workspace=@mtgc/web dev\"",
    "dev:web": "npm run --workspace=@mtgc/web dev",
    "dev:server": "npm run --workspace=@mtgc/server dev",
    "test": "npm run --workspaces --if-present test",
    "typecheck": "npm run build:shared && npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "sync:cards": "npm run --workspace=@mtgc/server sync:cards",
    "seed:presets": "npm run --workspace=@mtgc/server seed:presets",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "smoke:multibrowser": "playwright test apps/web/e2e/smoke-multibrowser.spec.ts --config apps/web/playwright.config.ts"
  },
  "dependencies": {
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
