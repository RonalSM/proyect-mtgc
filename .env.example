# Puerto y Host del servidor Backend
PORT=3001
HOST=0.0.0.0

# Base de datos (PostgreSQL)
POSTGRES_USER=mtgc_user
POSTGRES_PASSWORD=mtgc_password
POSTGRES_DB=mtgc_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mtgc_user:mtgc_password@localhost:5432/mtgc_db?schema=public

# Redis (Caché y estado en tiempo real)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Cliente Web
VITE_SERVER_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Scryfall API (Respetando límites: 50-100ms de retraso entre peticiones)
SCRYFALL_API_URL=https://api.scryfall.com
SCRYFALL_USER_AGENT=MTGCommanderVirtualTable/1.0.0 (contact: admin@mtgc.local)

# Seguridad y Autenticación
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
SESSION_SECRET=session_secret_key_change_in_production
